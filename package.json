{
  "name": "PANDORÆ",
  "version": "2-beta",
  "description": "A document-centered research protocol",
  "license": "MIT",
  "author": "Guillaume Levrier",
  "main": "./.webpack/main",
  "repository": {
    "type": "git",
    "url": "https://github.com/Guillaume-Levrier/PANDORAE/"
  },
  "scripts": {
    "update": "git pull && npm i",
    "start": "electron-forge start",
    "build:all": "cross-env NODE_ENV=production node bin/package.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@hownetworks/tracegraph": "^0.3.0",
    "@observablehq/inputs": "^0.12.0",
    "@observablehq/runtime": "^6.0.0",
    "bottleneck": "^2.19.5",
    "css-loader": "^7.1.2",
    "csv-parser": "^3.0.0",
    "d3": "7.9.0",
    "dexie": "^3.2.2",
    "dexie-export-import": "^4.1.2",
    "fastest-levenshtein": "^1.0.16",
    "merge-files": "^0.1.2",
    "mnemonist": "^0.39.5",
    "postprocessing": "^6.35.2",
    "style-loader": "^4.0.0",
    "three": "0.160.0",
    "versor": "^0.1.2",
    "whois-json": "^2.0.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.7.0",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron/fuses": "^2.1.1",
    "@vercel/webpack-asset-relocator-loader": "1.7.3",
    "cross-env": "^7.0.3",
    "del": "^4.1.1",
    "electron": "^41.5.0",
    "node-abi": "^2.19.3",
    "webpack": "^5.106.2"
  },
  "config": {
    "forge": {
      "plugins": [
        {
          "name": "@electron-forge/plugin-webpack",
          "config": {
            "mainConfig": "./webpack.main.config.js",
            "devContentSecurityPolicy": "default-src * self blob: data: gap:; style-src * self 'unsafe-inline' blob: data: gap:; script-src * 'self' 'unsafe-eval' 'unsafe-inline' blob: data: gap:; object-src * 'self' blob: data: gap:; img-src * self 'unsafe-inline' blob: data: gap:; connect-src self * 'unsafe-inline' blob: data: gap:; frame-src * self blob: data: gap:;",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "name": "main_window",
                  "html": "./html/index.html",
                  "js": "./js/index.js",
                  "preload": {
                    "js": "./js/preload-index.js"
                  }
                },
                {
                  "name": "flux",
                  "html": "./html/flux.html",
                  "js": "./js/flux.js",
                  "preload": {
                    "js": "./js/preload-flux.js"
                  }
                },
                {
                  "name": "chaeros",
                  "html": "./html/chaeros.html",
                  "js": "./js/chaeros.js",
                  "preload": {
                    "js": "./js/preload-chaeros.js"
                  }
                },
                {
                  "name": "database_manager",
                  "html": "./html/database_manager.html",
                  "js": "./js/database_manager.js",
                  "preload": {
                    "js": "./js/preload-database_manager.js"
                  }
                }
              ]
            }
          }
        }
      ],
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ],
          "config": {
            "icon": "/icons/PANDORAE"
          }
        }
      ]
    }
  },
  "build": {
    "artifactName": "PANDORAE.${ext}",
    "productName": "PANDORÆ",
    "win": {
      "icon": "PANDORAE.ico"
    },
    "mac": {
      "icon": "PANDORAE.icns"
    }
  }
}
